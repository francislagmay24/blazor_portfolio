<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Blazor Portfolio</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="nav-item px-3 nav-user">
                <div class="nav-user-name">@context.User.FindFirst("display_name")?.Value</div>
                <div class="nav-user-email">@context.User.Identity?.Name</div>

                @* Posted rather than linked so a plain GET cannot sign the user out. *@
                <form method="post" action="/auth/logout" class="nav-signout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-link nav-signout">Sign out</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>