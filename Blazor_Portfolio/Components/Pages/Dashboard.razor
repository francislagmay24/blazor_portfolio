@page "/dashboard"
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Hello, @context.User.FindFirst("display_name")?.Value!</h1>

        <p>You are signed in as <strong>@context.User.Identity?.Name</strong>.</p>
        <p>Welcome to your new app.</p>
    </Authorized>
    <NotAuthorized>
        <h1>Hello, world!</h1>
        <p>Welcome to your new app.</p>
    </NotAuthorized>
</AuthorizeView>